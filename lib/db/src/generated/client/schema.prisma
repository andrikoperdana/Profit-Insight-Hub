generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGEMENT
  PROJECT_MANAGER
  SALES
  KONSULTAN
  TECHNICAL_WRITER
  ADMIN_PROJECT
  PRINCIPAL_KONSULTAN
  PRINCIPAL_TECHNICAL_WRITER
  PRINCIPAL_ADMIN_PROJECT
  FINANCE
  HR
  SITE_ADMIN
  SUPER_ADMIN
}

enum ProjectKind {
  CLIENT
  INTERNAL
  PRESALES
  TRAINING
}

enum ProjectStatus {
  DRAFT
  OBSERVATION
  ACTIVE
  NO_NEED_CONSULTANT
  PAUSE
  COMPLETE
  CLOSED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ProjectReportType {
  DRAFT
  INTERIM
  FINAL
}

enum DocumentType {
  BAST
  INVOICE
  CONTRACT
  REPORT
  OTHER
}

enum DocumentKind {
  FILE
  LINK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  PRINCIPAL
}

enum BillingMilestoneStatus {
  PLANNED
  INVOICED
  PAID
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          UserRole
  title         String?
  dailyRate     Float?
  seniority     Seniority?
  isActive      Boolean    @default(true)
  avatarDataUrl String?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  managerId   String?
  manager     User?   @relation("UserManager", fields: [managerId], references: [id])
  reports     User[]  @relation("UserManager")
  principalId String?
  principal   User?   @relation("UserPrincipal", fields: [principalId], references: [id])
  supervisees User[]  @relation("UserPrincipal")

  skills           UserSkill[]
  approvedExpenses ProjectExpense[] @relation("ExpenseApprover")
  settledExpenses  ProjectExpense[] @relation("ExpenseSettler")

  projectsAsSales            Project[]                     @relation("ProjectSales")
  projectsAsPm               Project[]                     @relation("ProjectPm")
  projectsAsTw               Project[]                     @relation("ProjectTechWriter")
  projectsAsAdmin            Project[]                     @relation("ProjectAdmin")
  resources                  ProjectResource[]
  proposedResources          ProjectResource[]             @relation("ResourceProposer")
  createdResourceRates       ProjectResourceRate[]         @relation("ResourceRateCreator")
  timesheets                 Timesheet[]
  approvedTimesheets         Timesheet[]                   @relation("TimesheetApprover")
  documentsUploaded          Document[]
  activities                 Activity[]
  auditLogs                  AuditLog[]
  projectExpenses            ProjectExpense[]
  tasksAssigned              Task[]                        @relation("TaskAssignee")
  tasksCreated               Task[]                        @relation("TaskCreator")
  taskAssignments            TaskAssignee[]
  taskTimeLogs               TaskTimeLog[]
  notifications              Notification[]
  leadsOwned                 Lead[]                        @relation("LeadOwner")
  leadActivities             LeadActivity[]                @relation("LeadActivityCreator")
  leaves                     UserLeave[]
  taskTemplatesCreated       TaskTemplate[]                @relation("TaskTemplateCreator")
  projectTemplatesCreated    ProjectTemplate[]             @relation("ProjectTemplateCreator")
  projectReportsCreated      ProjectReport[]               @relation("ProjectReportCreator")
  closingChecklistsCompleted ProjectClosingChecklistItem[] @relation("ClosingChecklistCompleter")
  skillGoalsAsSubject        SkillDevelopmentGoal[]        @relation("SkillGoalSubject")
  skillGoalsCreated          SkillDevelopmentGoal[]        @relation("SkillGoalCreator")
  skillProgressionsAsSubject SkillProgressionLog[]         @relation("SkillProgressionSubject")
  skillProgressionsLogged    SkillProgressionLog[]         @relation("SkillProgressionChanger")

  feedback360AsReviewer ProjectFeedback360[] @relation("Feedback360Reviewer")
  feedback360AsSubject  ProjectFeedback360[] @relation("Feedback360Subject")

  raidItemsOwned          ProjectRaidItem[]                @relation("RaidOwner")
  raidItemsCreated        ProjectRaidItem[]                @relation("RaidCreator")
  baselinesCreated        ProjectBaseline[]                @relation("ProjectBaselineCreator")
  changeRequestsRequested ChangeRequest[]                  @relation("ChangeRequestRequester")
  changeRequestsDecided   ChangeRequest[]                  @relation("ChangeRequestDecider")
  perfReviewsSubject      PerformanceReview[]              @relation("PerfReviewSubject")
  perfReviewsAuthored     PerformanceReview[]              @relation("PerfReviewReviewer")
  perfProjectRatingsGiven PerformanceReviewProjectRating[] @relation("PerfProjRater")

  accessRequestsDecided AccessRequest[] @relation("AccessRequestDecider")
  accessRequestOrigin   AccessRequest?  @relation("AccessRequestCreatedUser")

  calendarTokenVersion Int @default(0)
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Google SSO access request: created when a verified @itsecasia.com Google
// account signs in but has no User yet. Site Admin approves (creates the User)
// or rejects from the dashboard. email is unique so repeated sign-in attempts
// upsert the same row instead of stacking duplicates.
model AccessRequest {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  googleSub     String
  status        AccessRequestStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?               @relation("AccessRequestDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdUserId String?             @unique
  createdUser   User?               @relation("AccessRequestCreatedUser", fields: [createdUserId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  industry       String?
  xeroContactId  String?
  pipedriveOrgId Int?     @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects Project[]
  leads    Lead[]
}

model Project {
  id                       String        @id @default(cuid())
  code                     String        @unique
  name                     String
  description              String?
  status                   ProjectStatus @default(OBSERVATION)
  kind                     ProjectKind   @default(CLIENT)
  clientId                 String
  client                   Client        @relation(fields: [clientId], references: [id])
  salesId                  String?
  sales                    User?         @relation("ProjectSales", fields: [salesId], references: [id])
  pmId                     String?
  pm                       User?         @relation("ProjectPm", fields: [pmId], references: [id])
  technicalWriterId        String?
  technicalWriter          User?         @relation("ProjectTechWriter", fields: [technicalWriterId], references: [id])
  adminProjectId           String?
  adminProject             User?         @relation("ProjectAdmin", fields: [adminProjectId], references: [id])
  startDate                DateTime?
  endDate                  DateTime?
  contractValue            Float         @default(0)
  currency                 String        @default("IDR")
  exchangeRate             Float         @default(1)
  vatPercent               Float         @default(11)
  contractValueIncludesVat Boolean       @default(true)
  estimatedCost            Float         @default(0)
  plannedMandays           Float         @default(0)
  lastStatusReason         String?
  reportCoverUrl           String?       @db.Text
  reportLink               String?       @db.Text
  reportSubmittedAt        DateTime?
  spkFileUrl               String?       @db.Text
  spkFileName              String?
  contractFileUrl          String?       @db.Text
  contractFileName         String?
  deletedAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  useWorkstreams Boolean @default(false)

  surveyToken     String?   @unique
  surveyEnabled   Boolean   @default(true)
  surveyExpiresAt DateTime?

  clientShareToken     String?   @unique
  clientShareEnabled   Boolean   @default(false)
  clientShareExpiresAt DateTime?

  resources          ProjectResource[]
  timesheets         Timesheet[]
  documents          Document[]
  activities         Activity[]
  surveyResponses    SurveyResponse[]
  expenses           ProjectExpense[]
  tasks              Task[]
  billingMilestones  BillingMilestone[]
  raidItems          ProjectRaidItem[]
  perfProjectRatings PerformanceReviewProjectRating[]
  closingChecklist   ProjectClosingChecklistItem[]
  feedback360        ProjectFeedback360[]
  workstreams        ProjectWorkstream[]
  reports            ProjectReport[]
  baselines          ProjectBaseline[]
  changeRequests     ChangeRequest[]

  @@index([pmId])
  @@index([salesId])
  @@index([clientId])
  @@index([status])
  @@index([deletedAt])
}

// A point-in-time snapshot of a project's scope/schedule/cost commitment.
// Exactly one baseline per project is `isCurrent` (the active commitment EVM and
// variance compare against). The first baseline is captured automatically when a
// project transitions to ACTIVE (source ACTIVATION); later versions are created
// when an approved Change Request is applied (source CHANGE_REQUEST) or manually.
model ProjectBaseline {
  id              String                @id @default(cuid())
  projectId       String
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int
  isCurrent       Boolean               @default(true)
  source          ProjectBaselineSource @default(ACTIVATION)
  changeRequestId String?
  changeRequest   ChangeRequest?        @relation("BaselineChangeRequest", fields: [changeRequestId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  plannedMandays  Float                 @default(0)
  estimatedCost   Float                 @default(0)
  contractValue   Float                 @default(0)
  createdById     String?
  createdBy       User?                 @relation("ProjectBaselineCreator", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())

  @@unique([projectId, version])
  @@index([projectId, isCurrent])
}

enum ProjectBaselineSource {
  ACTIVATION
  CHANGE_REQUEST
  MANUAL
}

model ChangeRequest {
  id                     String              @id @default(cuid())
  projectId              String
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type                   ChangeRequestType
  status                 ChangeRequestStatus @default(DRAFT)
  title                  String
  description            String?
  impactSummary          String?
  proposedStartDate      DateTime?
  proposedEndDate        DateTime?
  proposedPlannedMandays Float?
  proposedEstimatedCost  Float?
  proposedContractValue  Float?
  requestedById          String?
  requestedBy            User?               @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  decidedById            String?
  decidedBy              User?               @relation("ChangeRequestDecider", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  decisionNote           String?
  appliedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  baselines ProjectBaseline[] @relation("BaselineChangeRequest")

  @@index([projectId, status])
}

enum ChangeRequestType {
  SCOPE
  SCHEDULE
  COST
}

enum ChangeRequestStatus {
  DRAFT
  APPROVED
  APPLIED
  REJECTED
}

model ProjectReport {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  reportNumber String?
  version      String?
  reportType   ProjectReportType?
  periodStart  DateTime?
  periodEnd    DateTime?
  author       String?
  coverUrl     String?            @db.Text
  link         String?            @db.Text
  note         String?            @db.Text
  workstreamId String?
  workstream   ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  submittedAt  DateTime?
  createdById  String?
  createdBy    User?              @relation("ProjectReportCreator", fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([projectId])
  @@index([workstreamId])
}

model ProjectWorkstream {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?       @db.Text
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  allocationPct  Float         @default(0)
  plannedMandays Float         @default(0)
  estimatedCost  Float         @default(0)
  startDate      DateTime?
  endDate        DateTime?
  status         String        @default("ACTIVE")
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  resources         ProjectResource[]
  tasks             Task[]
  expenses          ProjectExpense[]
  billingMilestones BillingMilestone[]
  timesheets        Timesheet[]
  reports           ProjectReport[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([businessUnitId])
}

model SurveyQuestion {
  id        String   @id @default(cuid())
  key       String   @unique
  text      String
  type      String   @default("RATING") // RATING | TEXT
  order     Int      @default(0)
  required  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurveyResponse {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitterName     String?
  submitterEmail    String?
  answers           Json
  questionsSnapshot Json?
  lessonLearned     String?
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

enum Feedback360Status {
  PENDING
  SUBMITTED
}

model ProjectFeedback360 {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User              @relation("Feedback360Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     User              @relation("Feedback360Subject", fields: [subjectId], references: [id], onDelete: Cascade)
  rating      Int?
  comment     String?           @db.Text
  status      Feedback360Status @default(PENDING)
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, reviewerId, subjectId])
  @@index([reviewerId, status])
  @@index([projectId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String
  userRole    String
  action      String
  entityType  String
  entityId    String?
  description String
  dataBefore  Json?
  dataAfter   Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

model ProjectResource {
  id                       String                @id @default(cuid())
  projectId                String
  project                  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId             String?
  workstream               ProjectWorkstream?    @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  userId                   String
  user                     User                  @relation(fields: [userId], references: [id])
  roleInProject            String?
  plannedMandays           Float                 @default(0)
  dailyRate                Float                 @default(0)
  proposedById             String?
  proposedBy               User?                 @relation("ResourceProposer", fields: [proposedById], references: [id])
  proposedAt               DateTime?
  acceptedAt               DateTime?
  pendingPrincipalApproval Boolean               @default(false)
  createdAt                DateTime              @default(now())
  rates                    ProjectResourceRate[]

  @@unique([projectId, userId])
}

/// Append-only rate history for a project resource. `ProjectResource.dailyRate`
/// stays as the denormalized *current* cost rate; history rows change what
/// computeMetrics charges per timesheet workDate. sellingRate is display-only.
model ProjectResourceRate {
  id            String          @id @default(cuid())
  resourceId    String
  resource      ProjectResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  costRate      Float
  sellingRate   Float?
  effectiveFrom DateTime
  createdById   String?
  createdBy     User?           @relation("ResourceRateCreator", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  @@unique([resourceId, effectiveFrom])
  @@index([resourceId, effectiveFrom])
}

model Timesheet {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId    String?
  workstream      ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  taskId          String?
  task            Task?              @relation(fields: [taskId], references: [id])
  workDate        DateTime
  hours           Float
  description     String?
  status          TimesheetStatus    @default(DRAFT)
  approvedById    String?
  approvedBy      User?              @relation("TimesheetApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([workDate])
}

model Document {
  id               String       @id @default(cuid())
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             DocumentType
  kind             DocumentKind @default(FILE)
  fileName         String
  fileUrl          String       @db.Text
  invoiceNumber    String?
  invoiceAmount    Float?
  invoiceStatus    String?
  notes            String?
  uploadedById     String?
  uploadedBy       User?        @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime     @default(now())
  version          Int          @default(1)
  parentDocumentId String?
  parentDocument   Document?    @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  versions         Document[]   @relation("DocumentVersions")
  isLatest         Boolean      @default(true)

  billingMilestoneId String?
  billingMilestone   BillingMilestone? @relation(fields: [billingMilestoneId], references: [id], onDelete: Cascade)

  @@index([projectId, type, isLatest])
  @@index([billingMilestoneId])
}

model ProjectClosingChecklistItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key           String
  label         String
  status        String    @default("PENDING")
  note          String?   @db.Text
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("ClosingChecklistCompleter", fields: [completedById], references: [id])
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

model ProjectExpense {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId     String?
  workstream       ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  category         String
  description      String
  amount           Float
  spentAt          DateTime           @default(now())
  evidenceUrl      String?            @db.Text
  evidenceFileName String?
  status           ExpenseStatus      @default(PENDING)
  approvedById     String?
  approvedBy       User?              @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  poNumber         String?
  settledAmount    Float?
  settledAt        DateTime?
  settlementNotes  String?
  settledById      String?
  settledBy        User?              @relation("ExpenseSettler", fields: [settledById], references: [id])
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([projectId])
  @@index([spentAt])
  @@index([status])
}

model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  taskTemplates    TaskTemplate[]
  projectTemplates ProjectTemplate[]
  workstreams      ProjectWorkstream[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            UserSkill[]
  developmentGoals SkillDevelopmentGoal[]
  progressionLogs  SkillProgressionLog[]
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency Int      @default(3)
  createdAt   DateTime @default(now())

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model SkillDevelopmentGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("SkillGoalSubject", fields: [userId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  currentLevel Int       @default(1)
  targetLevel  Int       @default(3)
  targetDate   DateTime?
  status       String    @default("ACTIVE")
  notes        String?   @db.Text
  createdById  String?
  createdBy    User?     @relation("SkillGoalCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  @@unique([userId, skillId])
  @@index([userId])
  @@index([status])
}

model SkillProgressionLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("SkillProgressionSubject", fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  fromLevel   Int?
  toLevel     Int
  changedById String?
  changedBy   User?    @relation("SkillProgressionChanger", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([skillId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Task {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId    String?
  workstream      ProjectWorkstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus         @default(TODO)
  progressPercent Int                @default(0)
  billable        Boolean            @default(true)
  plannedHours    Float?
  startDate       DateTime?
  endDate         DateTime?
  assigneeId      String?
  assignee        User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById     String?
  createdBy       User?              @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  parentTaskId String?
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  timeLogs   TaskTimeLog[]
  assignees  TaskAssignee[]
  timesheets Timesheet[]

  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([parentTaskId])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model BillingMilestone {
  id                 String                 @id @default(cuid())
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workstreamId       String?
  workstream         ProjectWorkstream?     @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  percentage         Float                  @default(0)
  amount             Float?
  dueDate            DateTime?
  status             BillingMilestoneStatus @default(PLANNED)
  invoiceNumber      String?                @unique
  xeroInvoiceId      String?
  xeroInvoiceNumber  String?
  xeroAmountDue      Float?
  xeroAmountPaid     Float?
  xeroAmountCredited Float?
  xeroSyncedAt       DateTime?
  invoicedAt         DateTime?
  paidAt             DateTime?
  reportUrl          String?
  reportFiledAt      DateTime?
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  invoiceDocuments Document[]

  @@index([projectId])
  @@index([status])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskTimeLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([loggedAt])
}

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id                    String         @id @default(cuid())
  title                 String
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id])
  prospectiveClientName String?
  industry              String?
  source                String?
  region                String?
  stage                 LeadStage      @default(NEW)
  estimatedValue        Float          @default(0)
  probability           Int            @default(20)
  expectedCloseDate     DateTime?
  ownerId               String
  owner                 User           @relation("LeadOwner", fields: [ownerId], references: [id])
  notes                 String?
  lostReason            String?
  competitorWon         String?
  convertedProjectId    String?        @unique
  wonAt                 DateTime?
  lostAt                DateTime?
  deletedAt             DateTime?
  pipedriveDealId       Int?           @unique
  pipedrivePersonId     Int?
  pipedriveUpdatedAt    DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  activities            LeadActivity[]

  @@index([ownerId])
  @@index([stage])
  @@index([deletedAt])
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model LeadActivity {
  id             String           @id @default(cuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           LeadActivityType
  occurredAt     DateTime         @default(now())
  outcome        String?
  nextActionAt   DateTime?
  nextActionNote String?
  createdById    String
  createdBy      User             @relation("LeadActivityCreator", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([leadId, occurredAt])
  @@index([nextActionAt])
}

enum LeaveType {
  ANNUAL
  SICK
  TRAINING
  UNPAID
  OTHER
}

model UserLeave {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  type      LeaveType @default(ANNUAL)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, startDate])
  @@index([startDate, endDate])
}

model TaskTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  tasks          Json
  createdById    String
  createdBy      User          @relation("TaskTemplateCreator", fields: [createdById], references: [id])
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  projectTemplates ProjectTemplate[]

  @@index([businessUnitId, isActive])
}

model ProjectTemplate {
  id                       String        @id @default(cuid())
  name                     String
  description              String?       @db.Text
  businessUnitId           String?
  businessUnit             BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  kind                     ProjectKind   @default(CLIENT)
  defaultDurationDays      Int           @default(30)
  estimatedContractValue   Float         @default(0)
  estimatedCost            Float         @default(0)
  plannedMandays           Float         @default(0)
  vatPercent               Float         @default(11)
  contractValueIncludesVat Boolean       @default(true)
  taskTemplateId           String?
  taskTemplate             TaskTemplate? @relation(fields: [taskTemplateId], references: [id])
  isActive                 Boolean       @default(true)
  createdById              String
  createdBy                User          @relation("ProjectTemplateCreator", fields: [createdById], references: [id])
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  resources  ProjectTemplateResource[]
  milestones ProjectTemplateMilestone[]
  raidItems  ProjectTemplateRaidItem[]

  @@index([businessUnitId, isActive])
}

model ProjectTemplateResource {
  id             String          @id @default(cuid())
  templateId     String
  template       ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  role           String
  count          Int             @default(1)
  plannedMandays Float           @default(0)
  dailyRate      Float           @default(0)
  note           String?
  createdAt      DateTime        @default(now())

  @@index([templateId])
}

model ProjectTemplateMilestone {
  id         String          @id @default(cuid())
  templateId String
  template   ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  percentage Float           @default(0)
  offsetDays Int             @default(0)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([templateId])
}

model ProjectTemplateRaidItem {
  id          String          @id @default(cuid())
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type        RaidType
  title       String
  description String?         @db.Text
  impact      RaidImpact      @default(MEDIUM)
  likelihood  RaidLikelihood  @default(MEDIUM)
  mitigation  String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([templateId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum RaidType {
  RISK
  ASSUMPTION
  ISSUE
  DEPENDENCY
}

enum RaidImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RaidLikelihood {
  LOW
  MEDIUM
  HIGH
}

enum RaidStatus {
  OPEN
  MITIGATING
  CLOSED
}

enum RaidResponseStrategy {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
}

model ProjectRaidItem {
  id               String                @id @default(cuid())
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             RaidType
  title            String
  description      String?               @db.Text
  impact           RaidImpact            @default(MEDIUM)
  likelihood       RaidLikelihood        @default(MEDIUM)
  status           RaidStatus            @default(OPEN)
  ownerId          String?
  owner            User?                 @relation("RaidOwner", fields: [ownerId], references: [id])
  mitigation       String?               @db.Text
  responseStrategy RaidResponseStrategy?
  dueDate          DateTime?
  closedAt         DateTime?
  createdById      String?
  createdBy        User?                 @relation("RaidCreator", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([status])
}

enum PerformanceReviewPeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model PerformanceReview {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation("PerfReviewSubject", fields: [userId], references: [id])
  reviewerId      String
  reviewer        User                    @relation("PerfReviewReviewer", fields: [reviewerId], references: [id])
  period          PerformanceReviewPeriod
  periodYear      Int
  periodStart     DateTime
  periodEnd       DateTime
  status          PerformanceReviewStatus @default(DRAFT)
  overallRating   Int?
  summary         String?                 @db.Text
  strengths       String?                 @db.Text
  improvements    String?                 @db.Text
  goals           String?                 @db.Text
  acknowledgement String?                 @db.Text
  submittedAt     DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  projectRatings PerformanceReviewProjectRating[]

  @@unique([userId, period, periodYear])
  @@index([reviewerId])
  @@index([status])
}

model PerformanceReviewProjectRating {
  id        String            @id @default(cuid())
  reviewId  String
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ratedById String
  ratedBy   User              @relation("PerfProjRater", fields: [ratedById], references: [id])
  rating    Int
  comment   String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([reviewId, projectId])
  @@index([projectId])
}

model InvoiceSetting {
  id                String   @id @default("default")
  companyName       String
  brand             String
  addressLines      String[]
  npwp              String
  email             String
  phone             String
  city              String
  bankName          String
  bankAccountName   String
  bankAccountNumber String
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

model AppSetting {
  id                          String    @id @default("default")
  defaultVatPercent           Float     @default(11)
  timesheetBackdateDays       Int       @default(5)
  lowMarginPct                Float     @default(15)
  budgetOverrunPct            Float     @default(80)
  invoiceDueSoonDays          Int       @default(7)
  lateTimesheetDays           Int       @default(3)
  xeroAutoSyncEnabled         Boolean   @default(false)
  emailNotificationsEnabled   Boolean   @default(false)
  pipedriveAutoSyncEnabled    Boolean   @default(false)
  pipedriveLastSyncAt         DateTime?
  pipedriveDefaultOwnerId     String?
  pipedriveWebhookSecret      String?
  pipedriveSyncRunId          String?
  pipedriveSyncStartedAt      DateTime?
  pipedriveSyncFinishedAt     DateTime?
  pipedriveSyncError          String?   @db.Text
  pipedriveSyncResult         Json?
  // Cross-instance claim timestamp for the scheduled notification-rules run
  // (see api-server index.ts scheduler). Claimed atomically via updateMany.
  notificationChecksLastRunAt DateTime?
  updatedAt                   DateTime  @updatedAt
  updatedById                 String?
}

// Last generated Executive Copilot briefing, persisted so it survives restarts
// and is visible across autoscale instances. Single portfolio-wide row
// (id = "default"); payload holds { facts, briefing } JSON. Deliberately a
// separate table (NOT an AppSetting column): AppSetting is read on hot paths
// and a multi-KB blob would inflate every read.
model ExecutiveBriefing {
  id          String   @id @default("default")
  generatedAt DateTime
  model       String
  payload     Json
  updatedAt   DateTime @updatedAt
}

model PipedriveStageMapping {
  id                  String    @id @default(cuid())
  pipedrivePipelineId Int
  pipedriveStageId    Int       @unique
  leadStage           LeadStage
  label               String?
  updatedAt           DateTime  @updatedAt
}

model XeroConnection {
  id             String    @id @default("default")
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  tenantId       String
  tenantName     String?
  connectedAt    DateTime  @default(now())
  connectedById  String?
  disconnectedAt DateTime?
  updatedAt      DateTime  @updatedAt
}
