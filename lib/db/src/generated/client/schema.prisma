generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGEMENT
  PROJECT_MANAGER
  SALES
  KONSULTAN
  TECHNICAL_WRITER
  ADMIN_PROJECT
  PRINCIPAL_KONSULTAN
  PRINCIPAL_TECHNICAL_WRITER
  PRINCIPAL_ADMIN_PROJECT
  SITE_ADMIN
}

enum ProjectStatus {
  DRAFT
  OBSERVATION
  ACTIVE
  NO_NEED_CONSULTANT
  PAUSE
  COMPLETE
  CLOSED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DocumentType {
  BAST
  INVOICE
  CONTRACT
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  PRINCIPAL
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole
  title        String?
  dailyRate    Float?
  seniority    Seniority?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  managerId   String?
  manager     User?   @relation("UserManager", fields: [managerId], references: [id])
  reports     User[]  @relation("UserManager")
  principalId String?
  principal   User?   @relation("UserPrincipal", fields: [principalId], references: [id])
  supervisees User[]  @relation("UserPrincipal")

  skills           UserSkill[]
  approvedExpenses ProjectExpense[] @relation("ExpenseApprover")

  projectsAsSales    Project[]         @relation("ProjectSales")
  projectsAsPm       Project[]         @relation("ProjectPm")
  projectsAsTw       Project[]         @relation("ProjectTechWriter")
  projectsAsAdmin    Project[]         @relation("ProjectAdmin")
  resources          ProjectResource[]
  proposedResources  ProjectResource[] @relation("ResourceProposer")
  timesheets         Timesheet[]
  approvedTimesheets Timesheet[]       @relation("TimesheetApprover")
  documentsUploaded  Document[]
  activities         Activity[]
  auditLogs          AuditLog[]
  projectExpenses    ProjectExpense[]
  tasksAssigned      Task[]            @relation("TaskAssignee")
  tasksCreated       Task[]            @relation("TaskCreator")
  taskAssignments    TaskAssignee[]
  taskTimeLogs       TaskTimeLog[]
  notifications      Notification[]
}

model Client {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  industry      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

model Project {
  id                       String        @id @default(cuid())
  code                     String        @unique
  name                     String
  description              String?
  status                   ProjectStatus @default(OBSERVATION)
  clientId                 String
  client                   Client        @relation(fields: [clientId], references: [id])
  salesId                  String?
  sales                    User?         @relation("ProjectSales", fields: [salesId], references: [id])
  pmId                     String?
  pm                       User?         @relation("ProjectPm", fields: [pmId], references: [id])
  technicalWriterId        String?
  technicalWriter          User?         @relation("ProjectTechWriter", fields: [technicalWriterId], references: [id])
  adminProjectId           String?
  adminProject             User?         @relation("ProjectAdmin", fields: [adminProjectId], references: [id])
  startDate                DateTime?
  endDate                  DateTime?
  contractValue            Float         @default(0)
  vatPercent               Float         @default(11)
  contractValueIncludesVat Boolean       @default(true)
  estimatedCost            Float         @default(0)
  plannedMandays           Float         @default(0)
  lastStatusReason         String?
  reportCoverUrl           String?       @db.Text
  reportLink               String?       @db.Text
  reportSubmittedAt        DateTime?
  spkFileUrl               String?       @db.Text
  spkFileName              String?
  contractFileUrl          String?       @db.Text
  contractFileName         String?
  deletedAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  surveyToken     String?           @unique
  resources       ProjectResource[]
  timesheets      Timesheet[]
  documents       Document[]
  activities      Activity[]
  surveyResponses SurveyResponse[]
  expenses        ProjectExpense[]
  tasks           Task[]
}

model SurveyQuestion {
  id        String   @id @default(cuid())
  key       String   @unique
  text      String
  type      String   @default("RATING") // RATING | TEXT
  order     Int      @default(0)
  required  Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurveyResponse {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submitterName     String?
  submitterEmail    String?
  answers           Json
  questionsSnapshot Json?
  lessonLearned     String?
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  userName    String
  userRole    String
  action      String
  entityType  String
  entityId    String?
  description String
  dataBefore  Json?
  dataAfter   Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

model ProjectResource {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  roleInProject  String?
  plannedMandays Float     @default(0)
  dailyRate      Float     @default(0)
  proposedById   String?
  proposedBy     User?     @relation("ResourceProposer", fields: [proposedById], references: [id])
  proposedAt     DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([projectId, userId])
}

model Timesheet {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  taskId          String?
  task            Task?           @relation(fields: [taskId], references: [id])
  workDate        DateTime
  hours           Float
  description     String?
  status          TimesheetStatus @default(DRAFT)
  approvedById    String?
  approvedBy      User?           @relation("TimesheetApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([taskId])
}

model Document {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          DocumentType
  fileName      String
  fileUrl       String       @db.Text
  invoiceNumber String?
  invoiceAmount Float?
  invoiceStatus String?
  notes         String?
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime     @default(now())
}

model ProjectExpense {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category         String
  description      String
  amount           Float
  spentAt          DateTime      @default(now())
  evidenceUrl      String?       @db.Text
  evidenceFileName String?
  status           ExpenseStatus @default(PENDING)
  approvedById     String?
  approvedBy       User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([projectId])
  @@index([spentAt])
  @@index([status])
}

model BusinessUnit {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserSkill[]
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency Int      @default(3)
  createdAt   DateTime @default(now())

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  progressPercent Int        @default(0)
  billable        Boolean    @default(true)
  startDate       DateTime?
  endDate         DateTime?
  assigneeId      String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById     String?
  createdBy       User?      @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  timeLogs   TaskTimeLog[]
  assignees  TaskAssignee[]
  timesheets Timesheet[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskTimeLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  note      String?
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([loggedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
