{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "push": "if [ \"$ALLOW_DB_PUSH\" = \"1\" ]; then prisma db push --accept-data-loss; else echo 'db push is disabled — use migrations: pnpm --filter @workspace/db run migrate (override with ALLOW_DB_PUSH=1)'; exit 1; fi",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "catalog:",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  }
}
